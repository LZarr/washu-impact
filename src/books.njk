---
layout: layouts/base.njk
title: Request a Book
permalink: /books/
---
<section class="hero hero-small">
  <div class="wrap">
    <h2 style="text-align:center;">Request a Book</h2>
    <p class="lede" style="text-align:center; margin: 0 auto;">Fill out the form below to request one of the following books and have it directly shipped to you! We particularly recommend <em>The Precipice</em>, <em>The Scout Mindset</em>, and <em>The Alignment Problem</em>.</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="book-grid">
      {% for book in books %}
      <div class="book-card">
        <img src="{{ book.image | url }}" alt="{{ book.title }} cover" loading="lazy">
        <div class="book-title">{{ book.title }}</div>
        <div class="book-author">By {{ book.author }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section alt">
  <div class="wrap">
    <h3>Request your book</h3>
    <div class="embed-wrap">
      <iframe src="https://airtable.com/embed/shr4Ln5riSiH33isH" title="Book request form" loading="lazy"></iframe>
    </div>
  </div>
</section>
